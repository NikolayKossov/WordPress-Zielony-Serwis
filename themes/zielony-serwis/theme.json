{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1160px"
    },
    "color": {
      "palette": [
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#204f3c"
        },
        {
          "slug": "paper",
          "name": "Paper",
          "color": "#f6f5ed"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "Arial, sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "text": "#204f3c",
      "background": "#f6f5ed"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "18px",
      "lineHeight": "1.7"
    },
    "spacing": {
      "padding": {
        "left": "24px",
        "right": "24px"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "#204f3c"
        }
      },
      "button": {
        "color": {
          "background": "#204f3c",
          "text": "#f6f5ed"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
